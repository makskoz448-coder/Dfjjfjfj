local dragging, resizing = false, false
local dragStart, startPos, startSize

UIS.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if MainFrame.Visible then
            local pos = input.Position
            local fx, fy = MainFrame.AbsolutePosition.X, MainFrame.AbsolutePosition.Y
            local fw, fh = MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y

            if not cfgLocked and pos.X >= fx + fw - 40 and pos.X <= fx + fw + 10 and pos.Y >= fy + fh - 40 and pos.Y <= fy + fh + 10 then
                resizing = true; dragStart = pos; startSize = MainFrame.AbsoluteSize; return
            end

            if pos.X >= fx and pos.X <= fx + fw - 115 and pos.Y >= fy and pos.Y <= fy + 45 then
                dragging = true; dragStart = pos; startPos = MainFrame.Position
                GuideX.Visible, GuideY.Visible = true, true
                GuideX.Position = UDim2.new(0, 0, 0, MainFrame.AbsolutePosition.Y + MainFrame.AbsoluteSize.Y / 2)
                GuideY.Position = UDim2.new(0, MainFrame.AbsolutePosition.X + MainFrame.AbsoluteSize.X / 2, 0, 0)
            end
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if resizing and MainFrame then
            local d = input.Position - dragStart
            local nw = math.clamp(startSize.X + d.X, MIN_W, MAX_W_LIMIT)
            local nh = math.max(260, math.min(startSize.Y + d.Y, MAX_H_LIMIT))
            MainFrame.Size = UDim2.new(0, nw, 0, nh)
            cfgSize = Vector2.new(nw, nh)
            sizeLbl.Text = math.floor(nw) .. " × " .. math.floor(nh)
            setSlider((nw - MIN_W) / (MAX_W - MIN_W), false)
        elseif dragging and MainFrame then
            local d = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            GuideX.Position = UDim2.new(0, 0, 0, MainFrame.AbsolutePosition.Y + MainFrame.AbsoluteSize.Y / 2)
            GuideY.Position = UDim2.new(0, MainFrame.AbsolutePosition.X + MainFrame.AbsoluteSize.X / 2, 0, 0)
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if resizing then saveCfg() end
        if dragging then GuideX.Visible, GuideY.Visible = false, false end
        dragging, resizing = false, false
    end
end)

