local function applyThemeGUI(base, st)
    MainFrame.BackgroundColor3 = base
    MainStroke.Color = st
    Header.BackgroundColor3 = Color3.new(math.max(0, base.R*255 - 10)/255, math.max(0, base.G*255 - 10)/255, math.max(0, base.B*255 - 10)/255)
    Sidebar.BackgroundColor3 = Color3.new(math.max(0, base.R*255 - 15)/255, math.max(0, base.G*255 - 15)/255, math.max(0, base.B*255 - 15)/255)

    local modalCol = Color3.new(math.min(1, base.R + 0.1), math.min(1, base.G + 0.1), math.min(1, base.B + 0.13))
    Modal.BackgroundColor3 = modalCol
    ThemeModalObj.BackgroundColor3 = modalCol
    PartModal.BackgroundColor3 = modalCol

    for _, d in pairs(MainFrame:GetDescendants()) do
        if d.Name ~= "Snowflake" then
            if d:IsA("TextButton") and d.Name ~= "TabButton" and d ~= MHead and d ~= MClose and d ~= THead and d ~= TClose and d ~= PHead and d ~= PClose then
                d.BackgroundColor3 = Color3.new(math.min(1, base.R + 0.05), math.min(1, base.G + 0.05), math.min(1, base.B + 0.05))
            elseif d:IsA("Frame") and d ~= HeaderCover then
                d.BackgroundColor3 = Color3.new(math.min(1, base.R + 0.02), math.min(1, base.G + 0.02), math.min(1, base.B + 0.02))
            elseif d:IsA("ScrollingFrame") then
                d.BackgroundColor3 = Color3.new(math.max(0, base.R - 0.02), math.max(0, base.G - 0.02), math.max(0, base.B - 0.02))
            end
        end
    end

    for i = 1, 10 do
        local fBtn = FeaturesTab:FindFirstChild("FunctionButton_" .. i)
        if fBtn then
            fBtn.BackgroundColor3 = Color3.new(math.min(1, base.R + 0.05), math.min(1, base.G + 0.05), math.min(1, base.B + 0.05))
            local s = fBtn:FindFirstChild("UIStroke")
            if s then s.Color = st end
        end
    end
end

