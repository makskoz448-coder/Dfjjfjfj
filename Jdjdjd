local function applySize(w)
    w = math.clamp(w, MIN_W, MAX_W)
    local h = math.floor(w * BASE_RATIO)
    if h > MAX_H_LIMIT then h = MAX_H_LIMIT; w = math.floor(h / BASE_RATIO) end
    if w > MAX_W_LIMIT then w = MAX_W_LIMIT; h = math.floor(w * BASE_RATIO) end
    MainFrame.Size = UDim2.fromOffset(w, h)
    cfgSize = Vector2.new(w, h)
    sizeLbl.Text = w .. " × " .. h
end

local function setSlider(v, applyToFrame)
    v = math.clamp(v, 0, 1)
    SFill.Size = UDim2.new(v, 0, 1, 0)
    SKnob.Position = UDim2.new(v, 0, 0.5, 0)
    if applyToFrame then applySize(math.floor(MIN_W + (MAX_W - MIN_W) * v)) end
end
