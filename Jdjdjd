local function createModal(name, title, width, height)
    local M = Instance.new("Frame")
    M.Name = name
    M.Size = UDim2.fromOffset(width, height)
    M.AnchorPoint = Vector2.new(0.5, 0.5)
    M.Position = UDim2.new(0.5, 0, 0.5, 0)
    M.BackgroundColor3 = ORIG_GUI_MODAL
    M.BorderSizePixel = 0
    M.Visible = false
    M.ZIndex = 200
    M.Active = true
    M.Parent = MainGui
    corner(M, 10)
    stroke(M, Color3.fromRGB(110, 130, 180), 1.5)

    local MHead = Instance.new("TextButton")
    MHead.Size = UDim2.new(1, 0, 0, 30)
    MHead.BackgroundColor3 = Color3.fromRGB(52, 58, 76)
    MHead.Text = "  " .. title
    MHead.Font = Enum.Font.Code
    MHead.TextSize = 12
    MHead.TextColor3 = Color3.fromRGB(255, 255, 255)
    MHead.TextXAlignment = Enum.TextXAlignment.Left
    MHead.AutoButtonColor = false
    MHead.ZIndex = 201
    MHead.Parent = M
    corner(MHead, 10)

    local MHeadCover = Instance.new("Frame")
    MHeadCover.Position = UDim2.new(0, 0, 1, -8)
    MHeadCover.Size = UDim2.new(1, 0, 0, 8)
    MHeadCover.BackgroundColor3 = MHead.BackgroundColor3
    MHeadCover.BorderSizePixel = 0
    MHeadCover.ZIndex = 201
    MHeadCover.Parent = MHead

    local MClose = Instance.new("TextButton")
    MClose.Size = UDim2.new(0, 22, 0, 22)
    MClose.Position = UDim2.new(1, -26, 0.5, 0)
    MClose.AnchorPoint = Vector2.new(0, 0.5)
    MClose.BackgroundColor3 = Color3.fromRGB(150, 55, 55)
    MClose.Text = "X"
    MClose.Font = Enum.Font.Code
    MClose.TextSize = 13
    MClose.TextColor3 = Color3.fromRGB(255, 255, 255)
    MClose.AutoButtonColor = false
    MClose.ZIndex = 202
    MClose.Parent = MHead
    corner(MClose, 5)
    MClose.MouseButton1Click:Connect(function() M.Visible = false end)

    local MBody = Instance.new("Frame")
    MBody.Position = UDim2.new(0, 0, 0, 30)
    MBody.Size = UDim2.new(1, 0, 1, -30)
    MBody.BackgroundTransparency = 1
    MBody.ZIndex = 200
    MBody.Active = true
    MBody.Parent = M
    vlist(MBody, 8)
    pad(MBody, 10, 10, 12, 12)

    local mDrag, mStart, mPos = false, nil, nil
    local function dragStart(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            mDrag = true; mStart = i.Position; mPos = M.Position
        end
    end
    MHead.InputBegan:Connect(dragStart)
    MBody.InputBegan:Connect(dragStart)
    M.InputBegan:Connect(dragStart)

    UIS.InputChanged:Connect(function(i)
        if mDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - mStart
            M.Position = UDim2.new(mPos.X.Scale, mPos.X.Offset + d.X, mPos.Y.Scale, mPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            mDrag = false
        end
    end)

    return M, MBody, MHead, MClose
end

