local function applyFogPreset(preset)
    if getgenv().AeroFogLoop then getgenv().AeroFogLoop:Disconnect(); getgenv().AeroFogLoop = nil end
    CustomCC.Enabled = false
    CustomBloom.Enabled = false

    local orig = getgenv().DanyageyOrigLighting
    if not orig then return end

    if preset == "Выкл" then
        Lighting.FogColor = orig.FogColor
        Lighting.FogEnd = orig.FogEnd
        Lighting.Ambient = orig.Ambient
        Lighting.OutdoorAmbient = orig.OutdoorAmbient
        Lighting.ClockTime = orig.ClockTime
    elseif preset == "Северное сияние 🌌" then
        Lighting.ClockTime = 0
        Lighting.FogEnd = 800
        CustomCC.Enabled = true
        CustomCC.Contrast = 0.2
        CustomCC.Saturation = 0.5
        CustomCC.TintColor = Color3.fromRGB(150, 255, 200)
        CustomBloom.Enabled = true
        CustomBloom.Intensity = 0.6
        getgenv().AeroFogLoop = RunService.RenderStepped:Connect(function()
            local t = tick() * 0.2
            Lighting.FogColor = Color3.fromHSV(math.noise(t)*0.15 + 0.55, 0.8, 0.6)
            Lighting.Ambient = Color3.fromHSV(math.noise(t+10)*0.15 + 0.55, 0.8, 0.3)
            Lighting.OutdoorAmbient = Color3.fromHSV(math.noise(t+20)*0.15 + 0.55, 0.8, 0.3)
        end)
    elseif preset == "Радуга 🌈" then
        Lighting.ClockTime = 12
        Lighting.FogEnd = 800
        CustomBloom.Enabled = true
        CustomBloom.Intensity = 0.3
        getgenv().AeroFogLoop = RunService.RenderStepped:Connect(function()
            local h = (tick() % 5) / 5
            local color = Color3.fromHSV(h, 0.7, 1)
            Lighting.FogColor = color
            Lighting.Ambient = color
            Lighting.OutdoorAmbient = color
        end)
    elseif preset == "Кровавая луна 🩸" then
        Lighting.ClockTime = 0
        Lighting.FogEnd = 300
        Lighting.FogColor = Color3.fromRGB(120, 10, 10)
        Lighting.Ambient = Color3.fromRGB(50, 0, 0)
        Lighting.OutdoorAmbient = Color3.fromRGB(80, 10, 10)
        CustomCC.Enabled = true
        CustomCC.Contrast = 0.3
        CustomCC.Saturation = 0.8
        CustomCC.TintColor = Color3.fromRGB(255, 150, 150)
    elseif preset == "Киберпанк 🌃" then
        Lighting.ClockTime = 2
        Lighting.FogEnd = 400
        Lighting.FogColor = Color3.fromRGB(255, 0, 150)
        Lighting.Ambient = Color3.fromRGB(0, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(150, 0, 255)
        CustomBloom.Enabled = true
        CustomBloom.Intensity = 0.8
        CustomBloom.Threshold = 1.5
    elseif preset == "Токсичный ☢️" then
        Lighting.ClockTime = 14
        Lighting.FogEnd = 250
        Lighting.FogColor = Color3.fromRGB(80, 255, 50)
        Lighting.Ambient = Color3.fromRGB(50, 100, 20)
        Lighting.OutdoorAmbient = Color3.fromRGB(100, 200, 50)
        CustomCC.Enabled = true
        CustomCC.Contrast = 0.1
        CustomCC.TintColor = Color3.fromRGB(200, 255, 180)
    elseif preset == "Бездна 🕳️" then
        Lighting.ClockTime = 0
        Lighting.FogEnd = 50
        Lighting.FogColor = Color3.fromRGB(0, 0, 0)
        Lighting.Ambient = Color3.fromRGB(0, 0, 0)
        Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
    elseif preset == "Рассвет 🌅" then
        Lighting.ClockTime = 6.5
        Lighting.FogEnd = 800
        Lighting.FogColor = Color3.fromRGB(255, 150, 100)
        Lighting.Ambient = Color3.fromRGB(255, 100, 150)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 200, 150)
        CustomBloom.Enabled = true
        CustomBloom.Intensity = 0.3
    end
end

