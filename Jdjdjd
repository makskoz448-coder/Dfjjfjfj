local function applyThemeWM(base, st)
    WM.BackgroundColor3 = base
    WMStroke.Color = st
    local lum = 0.299 * base.R + 0.587 * base.G + 0.114 * base.B
    local textCol = lum < 0.5 and Color3.fromRGB(245, 250, 255) or Color3.fromRGB(25, 25, 30)
    for _, l in ipairs(wmLabels) do l.TextColor3 = textCol end
end

local function resetAllToOriginal()
    applyThemeGUI(ORIG_GUI_BASE, ORIG_GUI_STROKE)
    applyThemeWM(ORIG_WM_BASE, ORIG_WM_STROKE)
end

local function applyTheme(base, st)
    currentBase = base
    currentStroke = st
    resetAllToOriginal()
    if themeTarget == "gui" or themeTarget == "both" then applyThemeGUI(base, st) end
    if themeTarget == "wm" or themeTarget == "both" then applyThemeWM(base, st) end
end

