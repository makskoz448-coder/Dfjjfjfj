WorldPartFolder.Name = "Danyagey3DParticles"
WorldPartFolder.Parent = workspace

local worldParticlesPool = {}
local MAX_WORLD_PARTICLES = 100
local RANGE_XZ = 80
local SPAWN_HEIGHT = 60

local ptConfigMap = {
    ["Снежинки"] = { Shape = Enum.PartType.Ball,  Color = Color3.fromRGB(240, 248, 255), Mat = Enum.Material.Neon,         Size = Vector3.new(0.3, 0.3, 0.3) },
    ["Доллары"]  = { Shape = Enum.PartType.Block, Color = Color3.fromRGB(85, 170, 127),  Mat = Enum.Material.SmoothPlastic,Size = Vector3.new(0.8, 0.05, 0.4) },
    ["Молнии"]   = { Shape = Enum.PartType.Block, Color = Color3.fromRGB(255, 255, 0),   Mat = Enum.Material.Neon,         Size = Vector3.new(0.15, 1.2, 0.15) },
    ["Свинки"]   = { Shape = Enum.PartType.Block, Color = Color3.fromRGB(255, 170, 255), Mat = Enum.Material.SmoothPlastic,Size = Vector3.new(1.0, 0.8, 1.0) }
}

for i = 1, MAX_WORLD_PARTICLES do
    local part = Instance.new("Part")
    part.Size = Vector3.new(1, 1, 1)
    part.Transparency = 1
    part.CanCollide = false
    part.Anchored = true
    part.CastShadow = false
    part.Parent = WorldPartFolder

    table.insert(worldParticlesPool, {
        Part = part,
        Pos = Vector3.new(0, -9999, 0),
        RotX = math.random() * math.pi * 2,
        RotY = math.random() * math.pi * 2,
        RotZ = math.random() * math.pi * 2,
        RSpX = math.random(-3, 3),
        RSpY = math.random(-3, 3),
        RSpZ = math.random(-3, 3),
        Sp = math.random(10, 30),
        DrX = math.random(-5, 5),
        DrZ = math.random(-5, 5)
    })
end

local lastPtType = nil

local function updateWorldParticles(dt)
    if ptType == "Выкл" or not ptConfigMap[ptType] then
        for _, p in ipairs(worldParticlesPool) do
            p.Part.CFrame = CFrame.new(0, -9999, 0)
            p.Part.Transparency = 1
        end
        lastPtType = ptType
        return
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local center = root.Position
    local cfg = ptConfigMap[ptType]
    local needVisualUpdate = (lastPtType ~= ptType)
    lastPtType = ptType

    local activeCount = math.clamp(tonumber(ptAmount) or 30, 1, MAX_WORLD_PARTICLES)
    local globalSpeedMult = (tonumber(ptSpeed) or 50) / 50

    for i, p in ipairs(worldParticlesPool) do
        if i <= activeCount then
            if needVisualUpdate then
                p.Part.Shape = cfg.Shape
                p.Part.Size = cfg.Size
                p.Part.Color = cfg.Color
                p.Part.Material = cfg.Mat
                p.Part.Transparency = 0
            end

            p.Pos = p.Pos - Vector3.new(p.DrX * dt * 0.5, p.Sp * globalSpeedMult * dt, p.DrZ * dt * 0.5)

            p.RotX = p.RotX + p.RSpX * dt
            p.RotY = p.RotY + p.RSpY * dt
            p.RotZ = p.RotZ + p.RSpZ * dt

            local diffX = p.Pos.X - center.X
            local diffZ = p.Pos.Z - center.Z

            if p.Pos.Y < center.Y - 15 or math.abs(diffX) > RANGE_XZ or math.abs(diffZ) > RANGE_XZ then
                p.Pos = Vector3.new(
                    center.X + math.random(-RANGE_XZ, RANGE_XZ),
                    center.Y + SPAWN_HEIGHT + math.random(0, 20),
                    center.Z + math.random(-RANGE_XZ, RANGE_XZ)
                )
            end

            p.Part.CFrame = CFrame.new(p.Pos) * CFrame.Angles(p.RotX, p.RotY, p.RotZ)
        else
            p.Part.CFrame = CFrame.new(0, -9999, 0)
            p.Part.Transparency = 1
        end
    end
end

getgenv().AeroWorldParticlesLoop = RunService.RenderStepped:Connect(updateWorldParticles)

